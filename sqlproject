def validate_input(data):
    parts = data.split()
 
    if len(parts) != 3:
        return None
 
    id_value, name_value, age_value = parts
 
    try:
        id_value = int(id_value)
        if id_value <= 0:
            return None
    except:
        return None
 
    if name_value.isdigit() or not name_value.isalpha():
        return None
 
    try:
        age_value = float(age_value)
        if age_value < 0:
            return None
    except:
        return None
 
    return [id_value, name_value, age_value]
 
 
def check_user(ids_list):
    placeholders = ",".join(["%s"] * len(ids_list))
    query = f"SELECT id FROM students WHERE id IN ({placeholders})"
 
    cursor.execute(query, ids_list)
 
    return [row[0] for row in cursor.fetchall()]
 
 
